MPI_TYPE=MSMPI
XMSMPI_INC='$(subst \,/,$(MSMPI_INC))'
XMSMPI_LIB64='$(subst \,/,$(MSMPI_LIB64))'

ARCH=amd64
NM=nm
SED=sed
MPILIBA=libmsmpi64.a
PKG_CFLAGS= -I$(XMSMPI_INC) -DMSMPI_NO_DEPRECATE_20 -DWIN32
PKG_LIBS= $(MPILIBA) -ladvapi32 

SUBDIRS = common worker
SOURCES_C = RhpcMPI.c RhpcMPIlapplyLB.c RhpcMPIlapplyseq.c RhpcMPIWorkerCall.c registerDynamicSymbol.c
MKCONF = $(R_HOME)/etc$(R_ARCH)/Makeconf
COMMON_OBJECTS = common/RhpcSerialize.o common/RhpcMS.o
OBJECTS = $(SOURCES_C:.c=.o) $(COMMON_OBJECTS)

all: $(MPILIBA) subdirs $(SHLIB)

$(SHLIB): $(OBJECTS)

libmsmpi64.a: msmpi64.def
	$(DLLTOOL) -d msmpi64.def -k -l libmsmpi64.a -D msmpi.dll $(DT_ARCH)

clean: subdirsclean
	@-rm -f $(OBJECTS) $(SHLIB) libmsmpi64.a

subdirs: subdirsclean
	@for d in $(SUBDIRS); do \
		(cd $${d} && echo $(MAKE) -f Makefile.win -f $(MKCONF) )|| exit 1;\
	done
	@for d in $(SUBDIRS); do \
		(cd $${d} && $(MAKE) -f Makefile.win -f $(MKCONF) )|| exit 1;\
	done

subdirsclean:
	@for d in $(SUBDIRS); do \
		(cd $${d} && $(MAKE) -f Makefile.win MKCONF=$(MKCONF) clean)|| exit 1; \
	done
