SUBDIRS = common worker 
PKG_CFLAGS=@MPI_CFLAGS@
PKG_LIBS=@MPI_LDFLAGS@

SOURCES_C = RhpcMPI.c common/RhpcSerialize.c common/RhpcMS.c RhpcMPIWorkerCall.c RhpcMPIlapplyLB.c RhpcMPIlapplyseq.c registerDynamicSymbol.c
OBJECTS = $(SOURCES_C:.c=.o)
MKCONF = $(R_HOME)/etc${R_ARCH}/Makeconf

all: subdirs $(SHLIB)

clean: subdirsclean
	@-rm -f $(OBJECTS) $(SHLIB)

subdirs: subdirsclean
	@for d in $(SUBDIRS); do \
		(cd $${d} && MKCONF="$(MKCONF)" $(MAKE) ) || exit 1;\
	done

subdirsclean:
	@for d in $(SUBDIRS); do \
		(cd $${d} && MKCONF="$(MKCONF)" $(MAKE) clean)|| exit 1; \
	done
